    {
      "name": "1. Wallet top-up (positive)",
      "item": [
        {
          "name": "1.1 Get balance before top-up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const response = pm.response.json();",
                  "pm.test(\"Validate balance returned is a number\", () => pm.expect(response.balance).to.be.a(\"number\"));",
                  "",
                  "pm.environment.set(\"balanceBefore\", response.balance);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{businessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallet"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.2 Top up wallet with a valid amount",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Capture the wallet balance right before the top-up request is sent",
                  "pm.sendRequest({",
                  "    url: pm.environment.get(\"baseUrl\") + \"/api/v1/wallet\",",
                  "    method: \"GET\",",
                  "    header: {",
                  "        \"Content-Type\": \"application/json\",",
                  "        \"Authorization\": \"Bearer \" + pm.environment.get(\"businessToken\")",
                  "    }",
                  "}, (err, res) => {",
                  "    pm.environment.set(\"balanceBefore\", res.json().balance);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const topUpAmunt = Number(pm.environment.get(\"topUpAmount\"));",
                  "const balanceBefore = Number(pm.environment.get(\"balanceBefore\"));",
                  "const balanceAfterTopUp = Number(pm.response.json().balance);",
                  "",
                  "",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Validate wallets balance increases accordingly after top up\", () => {",
                  "    pm.expect(balanceAfterTopUp).to.eql(balanceBefore + topUpAmunt);",
                  "});",
                  "",
                  "",
                  "pm.environment.set(\"balanceAfterTopUp\", balanceAfterTopUp);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{businessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": {{topUpAmount}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallet/top-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallet",
                "top-up"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Delivery journey (happy path)",
      "item": [
        {
          "name": "2.1 Get a quote",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const weight = Number(pm.environment.get(\"weightKg\"));",
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Verify status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Verify quote was successfully created and quote_id generated\", () => {",
                  "    pm.expect(response.quote_id).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"Verify fee equals 1500 + 200 x weight\", () => pm.expect(response.fee).to.eql(1500 + 200 * weight));",
                  "",
                  "pm.environment.set(\"quoteId\", response.quote_id);",
                  "pm.environment.set(\"fee\", response.fee);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{businessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"pickup\": {\n        \"name\": \"Farouk\",\n        \"phone\": \"08031234567\",\n        \"address\": \"Ikeja\"\n    },\n    \"dropoff\": {\n        \"name\": \"Abiodun\",\n        \"phone\": \"08031234567\",\n        \"address\": \"Lekki\"\n    },\n    \"package\": {\n        \"description\": \"Grey watch\",\n        \"weight_kg\": {{weightKg}}\n    }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/deliveries/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "deliveries",
                "quote"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.2 Create a draft delivery",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Verify status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Verify delivery was successfully created and delivery_id generated\", () => {",
                  "    pm.expect(response.id).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"Verify delivery status is draft\", () => pm.expect(response.status).to.eql(\"draft\"));",
                  "pm.test(\"Verify delivery fee matches the quote fee\", () => pm.expect(response.fee).to.eql(Number(pm.environment.get(\"fee\"))));",
                  "",
                  "pm.environment.set(\"deliveryId\", response.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{businessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\":  { \"name\": \"Farouk\",  \"phone\": \"08031234567\", \"address\": \"Ikeja\" },\n  \"dropoff\": { \"name\": \"Abiodun\", \"phone\": \"08031234567\", \"address\": \"Lekki\" },\n  \"package\": { \"description\": \"Grey watch\", \"weight_kg\": {{weightKg}} },\n  \"quote_id\": \"{{quoteId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/deliveries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "deliveries"
              ]
            }
          },
          "response": []
        },
