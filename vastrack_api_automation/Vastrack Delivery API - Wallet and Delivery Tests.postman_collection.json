          "name": "2.3 Publish the delivery",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Verify status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Verify delivery status is pending after publish\", () => pm.expect(response.status).to.eql(\"pending\"));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{businessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/deliveries/{{deliveryId}}/publish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "deliveries",
                "{{deliveryId}}",
                "publish"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.4 Courier accepts the delivery",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Capture held amount and balance before the courier accepts",
                  "pm.sendRequest({",
                  "    url: pm.environment.get(\"baseUrl\") + \"/api/v1/wallet\",",
                  "    method: \"GET\",",
                  "    header: {",
                  "        \"Content-Type\": \"application/json\",",
                  "        \"Authorization\": \"Bearer \" + pm.environment.get(\"businessToken\")",
                  "    }",
                  "}, (err, res) => {",
                  "    const response = res.json();",
                  "    pm.environment.set(\"heldBeforeAccept\", response.held);",
                  "    pm.environment.set(\"balanceBeforeAccept\", response.balance);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Verify status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Verify delivery status is assigned\", () => pm.expect(response.status).to.eql(\"assigned\"));",
                  "pm.test(\"Verify a courier is attached to the delivery\", () => pm.expect(response.courier_id).to.be.a(\"string\"));",
                  "",
                  "const fee = Number(pm.environment.get(\"fee\"));",
                  "const heldBefore = Number(pm.environment.get(\"heldBeforeAccept\"));",
                  "const balanceBefore = Number(pm.environment.get(\"balanceBeforeAccept\"));",
                  "",
                  "pm.sendRequest({",
                  "    url: pm.environment.get(\"baseUrl\") + \"/api/v1/wallet\",",
                  "    method: \"GET\",",
                  "    header: {",
                  "        \"Content-Type\": \"application/json\",",
                  "        \"Authorization\": \"Bearer \" + pm.environment.get(\"businessToken\")",
                  "    }",
                  "}, (err, res) => {",
                  "    const wallet = res.json();",
                  "    pm.test(\"Verify held amount increased by the delivery fee after courier accepted\", () => {",
                  "        pm.expect(wallet.held).to.eql(heldBefore + fee);",
                  "    });",
                  "    pm.test(\"Verify wallet balance decreased by the delivery fee after courier accepted\", () => {",
                  "        pm.expect(wallet.balance).to.eql(balanceBefore - fee);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{courierToken}}"
