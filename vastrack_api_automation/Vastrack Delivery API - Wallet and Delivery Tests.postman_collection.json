        {
          "name": "2.7 Courier delivers with the code",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Capture held amount and balance before the courier delivers",
                  "pm.sendRequest({",
                  "    url: pm.environment.get(\"baseUrl\") + \"/api/v1/wallet\",",
                  "    method: \"GET\",",
                  "    header: {",
                  "        \"Content-Type\": \"application/json\",",
                  "        \"Authorization\": \"Bearer \" + pm.environment.get(\"businessToken\")",
                  "    }",
                  "}, (err, res) => {",
                  "    const response = res.json();",
                  "    pm.environment.set(\"heldBeforeDeliver\", response.held);",
                  "    pm.environment.set(\"balanceBeforeDeliver\", response.balance);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Verify status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Verify delivery status is delivered\", () => pm.expect(response.status).to.eql(\"delivered\"));",
                  "",
                  "const fee = Number(pm.environment.get(\"fee\"));",
                  "const heldBefore = Number(pm.environment.get(\"heldBeforeDeliver\"));",
                  "const balanceBefore = Number(pm.environment.get(\"balanceBeforeDeliver\"));",
                  "",
                  "pm.sendRequest({",
                  "    url: pm.environment.get(\"baseUrl\") + \"/api/v1/wallet\",",
                  "    method: \"GET\",",
                  "    header: {",
                  "        \"Content-Type\": \"application/json\",",
                  "        \"Authorization\": \"Bearer \" + pm.environment.get(\"businessToken\")",
                  "    }",
                  "}, (err, res) => {",
                  "    const wallet = res.json();",
                  "    pm.test(\"Verify held amount was released after delivery\", () => {",
                  "        pm.expect(wallet.held).to.eql(heldBefore - fee);",
                  "    });",
                  "    pm.test(\"Verify balance remaining is unchanged after settlement (fee charged exactly once)\", () => {",
                  "        pm.expect(wallet.balance).to.eql(balanceBefore);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{courierToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"code\": \"{{deliveryCode}}\" }"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/courier/deliveries/{{deliveryId}}/deliver",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
