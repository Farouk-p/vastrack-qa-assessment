            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courier/deliveries/{{deliveryId}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courier",
                "deliveries",
                "{{deliveryId}}",
                "accept"
